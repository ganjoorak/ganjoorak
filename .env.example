# Copy what you need into .env.local (Next.js) or the shell that runs the Go
# service. Commented lines are the defaults. No secrets belong in this file.
# .env and .env.local are gitignored.

# --- Web (next.config.js and server-side fetches) ---

# Ganjoor upstream. Read by next.config.js, server fetches, and `npm run build`.
# GANJOOR_API_BASE_URL=https://api.ganjoor.net
# NEXT_PUBLIC_GANJOOR_API_BASE_URL=https://api.ganjoor.net

# Semantic search host. Default https://ganjgah.ir
# src/server/ganjoorUpstream.ts
# GANJOOR_SEMANTIC_API_BASE_URL=https://ganjgah.ir

# Go accounts service. The /api/account/* rewrite is fixed when Next starts
# (`next dev`) or at `next build`. Default http://127.0.0.1:8787.
# The Docker image bakes in http://server:8787.
# ACCOUNTS_API_URL=http://127.0.0.1:8787

# Canonical URL for metadata. Default https://ganjoorak.ir.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 so a desktop build skips Next image optimization.
# DESKTOP_BUILD=

# Port Next listens on. Default 3000. The web image sets PORT=3000.
# PORT=3000

# --- Set by the host. Do not invent values for local dev. ---
# NODE_ENV                 development or production
# VERCEL                   set on Vercel; turns off output:standalone and enables analytics
# VERCEL_URL               used when NEXT_PUBLIC_SITE_URL is empty
# VERCEL_GIT_COMMIT_SHA    becomes the service-worker cache key
# NEXT_PUBLIC_BUILD_ID     injected by next.config.js from the commit SHA; do not set it

# --- prebuild, scripts/build-poet-source-index.mjs (runs on `npm run build`) ---
# SKIP_POET_IMAGE_DOWNLOAD=1
# DOWNLOAD_POET_IMAGES=0
# POET_IMAGE_DOWNLOAD_CONCURRENCY=8
# POET_IMAGE_DOWNLOAD_LIMIT=0

# --- Go accounts service (backend/main.go, backend/server.go) ---

# Listen address. Default 127.0.0.1:8787. The Docker image sets 0.0.0.0:8787.
# ACCOUNTS_ADDR=127.0.0.1:8787

# SQLite file. Default data/accounts.db (relative to the working directory).
# The Docker image sets /data/accounts.db.
# ACCOUNTS_DB=data/accounts.db

# Where quote and moshaere text is loaded from. Default http://127.0.0.1:3000.
# Compose sets http://web:3000.
# POEMS_API_URL=http://127.0.0.1:3000

# How X-Forwarded-For is trusted. Next.js rewrites forward the header unchanged.
# 0 (default) — rate-limit by the rightmost entry. Matches nginx
#   `proxy_set_header X-Forwarded-For $remote_addr` in docs/deploy-vps.md.
# N — skip N rightmost entries appended by trusted proxies. A shorter chain
#   falls back to the TCP peer.
# none — ignore the header and use the TCP peer. Set this for local
#   `next dev` + `go run` with no nginx, so a client cannot pick the key.
# TRUSTED_PROXY_HOPS=none
